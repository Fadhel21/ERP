<%- include('partials/kepala') %>
<body class="halaman-login">
<main class="login-wadah">
  <section class="login-kartu muncul" aria-labelledby="judul-login">
    <div class="login-merek">
      <span class="logo" aria-hidden="true">E</span>
      <div>
        <h1 id="judul-login">Masuk ke <%= namaAplikasi %></h1>
        <p class="teks-redup">Gunakan akun yang diberikan administrator.</p>
      </div>
    </div>

    <% if (galat) { %>
      <div class="notifikasi notifikasi-galat" role="alert">
        <%- include('partials/ikon', { nama: 'peringatan' }) %><span><%= galat %></span>
      </div>
    <% } %>

    <form method="post" action="/login" class="formulir" x-data="{ kirim: false }" @submit="kirim = true">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="kembali" value="<%= kembali %>">
      <div class="isian">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required autofocus
               value="<%= username %>" maxlength="50">
      </div>
      <div class="isian" x-data="{ lihat: false }">
        <label for="password">Password</label>
        <div class="isian-gabung">
          <input id="password" name="password" :type="lihat ? 'text' : 'password'" type="password"
                 autocomplete="current-password" required>
          <button type="button" class="tombol-teks" @click="lihat = !lihat"
                  x-text="lihat ? 'Sembunyikan' : 'Tampilkan'" aria-controls="password">Tampilkan</button>
        </div>
      </div>
      <button type="submit" class="tombol tombol-utama tombol-penuh" :disabled="kirim" :aria-busy="kirim">
        <%- include('partials/ikon', { nama: 'kunci' }) %>
        <span x-text="kirim ? 'Memproses…' : 'Masuk'">Masuk</span>
      </button>
    </form>
  </section>
</main>
</body>
</html>
