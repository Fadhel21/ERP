<%#
  Editor baris barang (Alpine). Variabel: barang, baris, galat, pakaiHarga (boolean), jenisAwal (untuk penyesuaian).
-%>
<fieldset class="grup-isian<%= galat.baris ? ' isian-galat' : '' %>">
  <legend>Barang</legend>
  <% if (galat.baris) { %><p class="pesan-galat"><%- include('../partials/ikon', { nama: 'peringatan' }) %><%= galat.baris %></p><% } %>
  <div class="tabel-wadah tabel-baris">
    <table class="tabel">
      <thead><tr>
        <th scope="col" class="kolom-no">#</th>
        <th scope="col">Barang</th>
        <th scope="col" class="angka kolom-qty">Qty</th>
        <% if (pakaiHarga) { %><th scope="col" class="angka kolom-harga" x-show="pakaiHarga">Harga satuan</th><% } %>
        <th scope="col" class="kolom-aksi"><span class="sr-only">Hapus baris</span></th>
      </tr></thead>
      <tbody>
        <template x-for="(b, i) in baris" :key="b.k">
          <tr class="baris-masuk">
            <td class="kolom-no angka" x-text="i + 1"></td>
            <td>
              <select name="barang_id" x-model="b.barang_id" :aria-invalid="!!b.galat.barang_id" aria-label="Barang"
                      @change="isiHarga(b, $event.target)">
                <option value="">— Pilih barang —</option>
                <% barang.forEach((x) => { %>
                  <option value="<%= x.id %>" data-harga="<%= formatDesimal(x.harga) %>" data-satuan="<%= x.satuan %>"><%= x.kode %> · <%= x.nama %></option>
                <% }) %>
              </select>
              <p class="pesan-galat" x-show="b.galat.barang_id" x-text="b.galat.barang_id"></p>
            </td>
            <td>
              <div class="isian-satuan">
                <input name="qty" x-model="b.qty" inputmode="decimal" class="angka rata-kanan" aria-label="Qty" :aria-invalid="!!b.galat.qty">
                <span class="satuan" x-text="satuan(b.barang_id)"></span>
              </div>
              <p class="pesan-galat" x-show="b.galat.qty" x-text="b.galat.qty"></p>
            </td>
            <% if (pakaiHarga) { %>
              <td x-show="pakaiHarga">
                <input name="harga_satuan" x-model="b.harga_satuan" inputmode="decimal" class="angka rata-kanan" aria-label="Harga satuan"
                       :disabled="!pakaiHarga" :aria-invalid="!!b.galat.harga_satuan">
                <p class="pesan-galat" x-show="b.galat.harga_satuan" x-text="b.galat.harga_satuan"></p>
              </td>
            <% } %>
            <td class="kolom-aksi">
              <button type="button" class="tombol-ikon kecil bahaya" @click="hapus(i)" :disabled="baris.length === 1" aria-label="Hapus baris">
                <%- include('../partials/ikon', { nama: 'hapus' }) %>
              </button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
  <button type="button" class="tombol tombol-sekunder kecil" @click="tambah()">
    <%- include('../partials/ikon', { nama: 'tambah' }) %><span>Tambah baris</span>
  </button>
</fieldset>
