<%#
  Ikon ilustrasi duotone 48px untuk panel login, masing-masing dengan animasi bermakna.
  Warna: --c1 (garis utama), --c2 (isi lembut). Dekoratif → aria-hidden.
-%>
<%
const gambar = {
  persediaan: `
    <g class="anim-kotak">
      <path d="M24 6 40 14v18L24 40 8 32V14Z" fill="var(--c2)"/>
      <path d="M24 6 40 14v18L24 40 8 32V14Z M8 14l16 8 16-8 M24 22v18"/>
    </g>
    <path class="anim-bayangan" d="M12 44h24" opacity=".35"/>`,
  pembelian: `
    <g class="anim-troli">
      <path d="M10 12h28l-4 16H14Z" fill="var(--c2)"/>
      <path d="M4 6h5l5 22h20l4-16H10"/>
      <circle class="anim-roda" cx="17" cy="37" r="3"/><circle class="anim-roda" cx="31" cy="37" r="3"/>
      <path class="anim-barang" d="M19 12v-4h10v4" />
    </g>`,
  penjualan: `
    <rect x="6" y="6" width="36" height="36" rx="6" fill="var(--c2)" stroke="none"/>
    <path class="anim-garis" pathLength="100" d="M11 33l8-9 6 5 12-14"/>
    <path class="anim-panah" d="M31 15h6v6"/>`,
  akuntansi: `
    <rect x="10" y="4" width="28" height="40" rx="5" fill="var(--c2)"/>
    <rect x="10" y="4" width="28" height="40" rx="5"/>
    <rect x="15" y="9" width="18" height="8" rx="2"/>
    <g class="anim-tombol">
      <circle cx="18" cy="24" r="1.6"/><circle cx="24" cy="24" r="1.6"/><circle cx="30" cy="24" r="1.6"/>
      <circle cx="18" cy="31" r="1.6"/><circle cx="24" cy="31" r="1.6"/><circle cx="30" cy="31" r="1.6"/>
      <circle cx="18" cy="38" r="1.6"/><circle cx="24" cy="38" r="1.6"/><circle cx="30" cy="38" r="1.6"/>
    </g>`,
  laporan: `
    <path d="M6 42h36" />
    <rect class="anim-batang" style="--d:0s" x="9" y="24" width="7" height="18" rx="1.5" fill="var(--c2)"/>
    <rect class="anim-batang" style="--d:.2s" x="20.5" y="12" width="7" height="30" rx="1.5" fill="var(--c2)"/>
    <rect class="anim-batang" style="--d:.4s" x="32" y="18" width="7" height="24" rx="1.5" fill="var(--c2)"/>`,
  master: `
    <g class="anim-db" style="--d:0s"><ellipse cx="24" cy="11" rx="14" ry="5" fill="var(--c2)"/><ellipse cx="24" cy="11" rx="14" ry="5"/></g>
    <g class="anim-db" style="--d:.25s"><path d="M10 11v10c0 2.8 6.3 5 14 5s14-2.2 14-5V11"/></g>
    <g class="anim-db" style="--d:.5s"><path d="M10 21v10c0 2.8 6.3 5 14 5s14-2.2 14-5V21"/></g>
    <path d="M10 31v6c0 2.8 6.3 5 14 5s14-2.2 14-5v-6"/>`,
};
-%>
<svg class="ilustrasi ilustrasi-<%= nama %>" viewBox="0 0 48 48" fill="none" stroke="var(--c1)" stroke-width="2.2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%- gambar[nama] %></svg>
