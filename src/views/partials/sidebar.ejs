<% const daftarMenu = menuUntuk(boleh, path); -%>
<aside class="sidebar" :class="{ 'sidebar-buka': menuBuka }" @keydown.escape.window="menuBuka = false">
  <div class="sidebar-merek">
    <span class="logo" aria-hidden="true">E</span>
    <span><%= namaAplikasi %></span>
    <button type="button" class="tombol-ikon hanya-seluler" @click="menuBuka = false" aria-label="Tutup menu">
      <%- include('ikon', { nama: 'tutup' }) %>
    </button>
  </div>
  <nav aria-label="Menu utama">
    <ul class="menu">
      <% daftarMenu.forEach((m, i) => { %>
        <li style="--urut: <%= i %>">
          <% if (!m.anak.length) { %>
            <a href="<%= m.href %>" class="menu-item<%= m.aktif ? ' aktif' : '' %>" <%- m.aktif ? 'aria-current="page"' : '' %>>
              <%- include('ikon', { nama: m.ikon }) %><span><%= m.label %></span>
            </a>
          <% } else { %>
            <div x-data="{ buka: <%= m.aktif %> }" class="menu-grup<%= m.aktif ? ' menu-grup-buka' : '' %>" :class="{ 'menu-grup-buka': buka }">
              <button type="button" class="menu-item<%= m.aktif ? ' aktif-induk' : '' %>" @click="buka = !buka"
                      :aria-expanded="buka" aria-controls="sub-<%= m.kode %>">
                <%- include('ikon', { nama: m.ikon }) %><span><%= m.label %></span>
                <%- include('ikon', { nama: 'panah', kelas: 'menu-panah' }) %>
              </button>
              <div class="submenu-wadah"><ul class="submenu" id="sub-<%= m.kode %>">
                <% m.anak.forEach((a) => { %>
                  <li>
                    <% if (a.tersedia) { %>
                      <a href="<%= a.href %>" class="submenu-item<%= a.aktif ? ' aktif' : '' %>" <%- a.aktif ? 'aria-current="page"' : '' %>><%= a.label %></a>
                    <% } else { %>
                      <span class="submenu-item nonaktif" aria-disabled="true" title="Belum tersedia"><%= a.label %><em class="lencana">Segera</em></span>
                    <% } %>
                  </li>
                <% }) %>
              </ul></div>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </nav>
</aside>
