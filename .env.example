# Salin menjadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/erp
# Untuk tes otomatis (database terpisah, akan dikosongkan saat tes)
DATABASE_URL_TES=postgres://postgres:PASSWORD@localhost:5432/erp_tes
# Rahasia acak panjang, minimal 32 karakter
JWT_SECRET=ganti-dengan-rahasia-acak-panjang
COOKIE_SECRET=ganti-dengan-rahasia-acak-lain
SMTP_URL=
